# Scheduled jobs (/api/cron/daily and /api/cron/fuel). Vercel project env only; not needed to build.
CRON_SECRET=

# Fuel Price Tracker: Brent and WTI daily closes from Alpha Vantage (free key at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=
# Optional: the Gemini model that reads Petroleum Division release images (defaults to GEMINI_VISION_MODEL)
GEMINI_FUEL_MODEL=
